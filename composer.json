{
  "name": "ekods/custom-fields-framework-pro",
  "description": "Development tooling for Custom Fields Framework Pro",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "scripts": {
    "lint": "find . -path './vendor' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "release:check": "bash scripts/check-release-metadata.sh",
    "release:zip": "bash scripts/build-release-zip.sh",
    "release:validate": "bash scripts/validate-release-zip.sh",
    "release:sync": "bash scripts/sync-to-release-repo.sh"
  }
}
