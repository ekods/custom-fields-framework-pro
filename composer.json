{
  "name": "ekods/custom-fields-framework-pro",
  "description": "Development tooling for Custom Fields Framework Pro",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "scripts": {
    "test:frontend-visibility": "php tests/frontend-visibility.php",
    "test:language-clone": "php tests/language-clone.php",
    "test:runtime-integrity": "php tests/runtime-integrity.php",
    "test:relational-labels": "php tests/relational-labels.php",
    "test:relational-select2": "node tests/relational-select2.cjs",
    "test:relational-theme-select2": "node tests/relational-theme-select2.cjs",
    "lint": "find . -path './vendor' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "release:check": "bash scripts/check-release-metadata.sh",
    "release:zip": "bash scripts/build-release-zip.sh",
    "release:validate": "bash scripts/validate-release-zip.sh",
    "release:sync": "bash scripts/sync-to-release-repo.sh"
  }
}
